# Scout Alpha — environment configuration template.
# Copy to .env and fill in real values. Never commit .env.

# =====================================================================
# ACTIVE IN PHASE 1 (signal ingestion) — these are the only variables any
# code actually reads right now.
# =====================================================================

# paper = simulated trades only (the only supported mode; unrelated to
#         ingestion, but asserted here since it's a system-wide gate)
# live  = real execution — NOT YET IMPLEMENTED anywhere in this codebase.
TRADING_MODE=paper

# --- Scout signal ingestion ---
# Leave TELEGRAM_API_ID / TELEGRAM_API_HASH / TELEGRAM_SESSION_STRING blank
# to run `npm run ingest:dev` against the bundled real captured fixture
# messages instead of a live connection. See src/ingestion/README.md for
# exactly how to obtain each of these (my.telegram.org + `npm run
# telegram:login`) — do not paste secrets into any source file.
SCOUT_TELEGRAM_CHANNEL=scoutrobinhood
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Optional override for where captured signals are stored. Defaults to
# data/signals.ndjson (gitignored) if unset.
SIGNAL_STORE_PATH=

LOG_LEVEL=info

# =====================================================================
# ACTIVE IN PHASE 2 (Robinhood Chain data layer) — read-only. See
# docs/DATA_SOURCES.md for exactly what was verified.
# =====================================================================

# Official public RPC is used by default (rate-limited, fine for this
# phase's read volume — see docs/DATA_SOURCES.md §1). Override with a paid
# provider (Alchemy is Robinhood's primary recommendation) for anything
# beyond light development use. Leave blank to use the documented default:
# https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_RPC_URL=

# Optional WebSocket RPC — not used by anything in Phase 2 (all access is
# request/response), reserved for a future live-subscription use case.
# Documented default: wss://feed.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_WS_URL=

# No API key is used for DexScreener or Blockscout in this phase — both
# were tested unauthenticated. See docs/DATA_SOURCES.md §3-4 for the
# reliability caveats (Blockscout is intermittently gated by Cloudflare).

# =====================================================================
# RESERVED FOR LATER PHASES — not read by any code yet. Listed here so the
# full eventual configuration surface is visible, per ARCHITECTURE.md /
# PROJECT_PLAN.md. Leave blank.
# =====================================================================

ROBINHOOD_CHAIN_ID=4663

# --- Persistence (only if/when this graduates beyond the Phase 1 file store) ---
DATABASE_URL=

# --- Paper trading parameters (needed starting with the paper-trading phase) ---
PAPER_STARTING_BALANCE_USD=10000
MAX_POSITION_SIZE_USD=250
RISK_MAX_DAILY_LOSS_USD=500
RISK_MAX_OPEN_POSITIONS=5
